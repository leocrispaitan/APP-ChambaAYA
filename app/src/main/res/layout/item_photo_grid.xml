<?xml version="1.0" encoding="utf-8"?>
<!-- Item para galería de fotos 3x3 grid -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/avatar_katty"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedCorner12" />

    <!-- Overlay gradient para texto/iconos si se necesita -->
    <View
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_black_bottom"
        android:alpha="0.6"
        android:visibility="gone" />

</FrameLayout>
