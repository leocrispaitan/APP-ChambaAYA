<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de categoría/oficio para la fila horizontal del mapa. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="116dp"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardBackgroundColor="#F8F9FB"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E8EBF0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/layoutMapCat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivMapCatIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvMapCatName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:maxLines="3"
            android:minHeight="32dp"
            android:textColor="#0F172A"
            android:textSize="11sp"
            tools:text="Pintura" />

        <TextView
            android:id="@+id/tvMapCatCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1E293B"
            android:textSize="11sp"
            tools:text="2" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
