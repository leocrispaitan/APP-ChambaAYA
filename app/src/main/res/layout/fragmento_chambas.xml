<?xml version="1.0" encoding="utf-8"?>
<!--
    fragmento_chambas.xml â€” Home Screen de ChambAYA
    DiseÃ±o optimizado con CoordinatorLayout para scroll fluido y rendimiento mejorado.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.jobs.FragmentoChambas">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_brand"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Fila 1: Marca ChambAYA + Campana -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerTopRow"
                android:layout_width="match_parent"
                android:layout_height="68dp">

                <LinearLayout
                    android:id="@+id/llBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/logo"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/sora_bold"
                        android:text="Chamb"
                        android:textColor="@color/white"
                        android:textSize="23sp"
                        android:letterSpacing="0.01" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_bold"
                        android:text="AYA"
                        android:textColor="#25D6F4"
                        android:textSize="23sp"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- Pin + Nombre de ciudad + Chevron -->
                <LinearLayout
                    android:id="@+id/llLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="48dp"
                    app:layout_constraintStart_toStartOf="@id/llBrand"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_home_location"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvLocationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/home_location_value"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- BotÃ³n campana circular semitransparente -->
                <ImageButton
                    android:id="@+id/btnNotifications"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_bell_circle"
                    android:src="@drawable/ic_home_bell"
                    android:contentDescription="Notificaciones"
                    android:scaleType="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- FASE 14 Â· Badge de no leÃ­dos -->
                <TextView
                    android:id="@+id/tvNotifBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_badge_unread"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:visibility="gone"
                    android:elevation="2dp"
                    tools:visibility="visible"
                    tools:text="3"
                    app:layout_constraintTop_toTopOf="@id/btnNotifications"
                    app:layout_constraintEnd_toEndOf="@id/btnNotifications" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="4dp" />

            <!-- Fila 2: buscador + filtros. BÃºsqueda simple por texto. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Barra de bÃºsqueda -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_home_search"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="sans-serif"
                        android:hint="@string/home_search_hint"
                        android:textColorHint="#AAAAAA"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:paddingStart="10dp"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- BotÃ³n filtro cuadrado redondeado -->
                <ImageButton
                    android:id="@+id/btnFilter"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_filter_button"
                    android:src="@drawable/ic_home_filter"
                    android:contentDescription="Filtros"
                    android:scaleType="center" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/transparent" />
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- TÃ­tulo + Ver todo -->
            

            <!-- Banner Principal de Oferta -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBannerMain"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/frameBannerBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/brand_color">

                    <ImageView
                        android:id="@+id/ivBannerPhoto"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/chamba_banner_chambas_cerca"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.48" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@color/brand_color"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.60" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.60">

                        <TextView
                            android:id="@+id/tvBannerBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_white"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/home_banner_badge"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvBannerTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif-black"
                            android:lineSpacingMultiplier="1.05"
                            android:text="@string/home_banner_title"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tvBannerSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/home_banner_subtitle"
                            android:textColor="#E6FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvBannerPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvBannerLegal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/home_banner_legal"
                            android:textColor="#B3FFFFFF"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnBannerCta"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_badge_white"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:stateListAnimator="@null"
                            android:text="@string/home_banner_cta"
                            android:textColor="@color/brand_color"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/home_explora_titulo"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="2dp"
                android:text="@string/home_explora_sub"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Grid de categorÃ­as (horizontal) - mismas imÃ¡genes que ChambAYA-APP-main -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="9dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_categoria" />

            <LinearLayout
                android:id="@+id/feedModeTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="0dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabBusinessJobs"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:text="Empleos"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_tab_publicar"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabFreeTime"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:text="Tiempo Libre"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_calendar_small"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>

            <!-- TÃ­tulo + Temporizador -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tvFlashTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/home_flash_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Etiqueta tiempo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/home_flash_closing"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFlashTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/home_flash_time"
                        android:textColor="@color/brand_color"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <!-- Feed de trabajos estilo Instagram â€” 1 tarjeta por fila, ancho completo -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_job_card"
                tools:itemCount="3" />

            <!-- FASE 6 Â· Estado de carga del feed -->
            <LinearLayout
                android:id="@+id/layoutFeedLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_feed_cargando"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- FASE 6 Â· Estado vacÃ­o del feed -->
            <LinearLayout
                android:id="@+id/layoutFeedEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="28dp"
                android:paddingEnd="32dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_home_search"
                    android:alpha="0.4" />

                <TextView
                    android:id="@+id/tvFeedEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/home_feed_vacio_titulo"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvFeedEmptySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/home_feed_vacio_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnFeedEmptyAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/home_feed_recargar"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- FASE 6 Â· Estado de error del feed -->
            <LinearLayout
                android:id="@+id/layoutFeedError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="28dp"
                android:paddingEnd="32dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/home_feed_error_titulo"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvFeedErrorDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/home_feed_error_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnFeedRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/home_feed_reintentar"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

