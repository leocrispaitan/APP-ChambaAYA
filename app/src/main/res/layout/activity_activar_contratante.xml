<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnCerrarContratante"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile_arrow_back"
                    android:contentDescription="Volver"
                    app:tint="#111827" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activar modo contratante"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Usarás la misma cuenta y conservarás tu perfil de trabajador."
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Cómo vas a contratar?"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTipoContratante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/rbContratantePersona"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Persona"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbContratanteEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Empresa" />

                    <RadioButton
                        android:id="@+id/rbContratanteNegocio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Negocio" />

                    <RadioButton
                        android:id="@+id/rbContratanteIndependiente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Independiente" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvDocumentoContratanteLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="DNI"
                    android:textColor="#1F2937"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDocumentoContratante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:hint="Ingresa tu DNI"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="#111827"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvDocumentoContratanteEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Se verificará con RENIEC o SUNAT antes de guardar."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Nombre / razón social"
                    android:textColor="#1F2937"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNombreContratante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:hint="Nombre del contratante"
                    android:paddingHorizontal="16dp"
                    android:textColor="#111827"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etNombreComercialContratante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:hint="Nombre comercial"
                    android:paddingHorizontal="16dp"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etSectorContratante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:hint="Sector o actividad"
                    android:paddingHorizontal="16dp"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tus datos de TRABAJADOR no se eliminarán. Si ya activaste este modo anteriormente, sus datos se cargarán automáticamente."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarContratante"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="Activar modo contratante"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#5B67F7"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
