<?xml version="1.0" encoding="utf-8"?>
<!--
    Buscador de lugares del feed (Geocode Earth / Pelias).
    Calle, restaurante, mercado, barrio o distrito: al elegir uno, el feed
    se recorta a ese punto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="¿Dónde buscas chambas?"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Escribe una calle, un restaurante o un lugar de Ayacucho."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Campo de búsqueda de lugares -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/etGeoSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif"
            android:hint="Jr. Los Libertadores, mercado, farmacia…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnGeoClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Limpiar búsqueda"
            android:scaleType="center"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Atajos: los lugares que la gente más busca para trabajar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGeoQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRestaurantes"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restaurantes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFarmacias"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farmacias" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMercados"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mercados" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipColegios"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colegios" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMunicipalidad"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Municipalidad" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUniversidades"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Universidades" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- GPS: coloca el feed donde está el usuario -->
    <LinearLayout
        android:id="@+id/btnGeoMyLocation"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_lugar_sector_chip"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_my_location"
            app:tint="@color/brand_color" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Usar mi ubicación"
            android:textColor="@color/brand_color"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGeoMyLocationHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Chambas a mi alrededor"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sugerencias -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="120dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGeoResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="4"
            tools:listitem="@layout/item_geo_place" />

        <ProgressBar
            android:id="@+id/progressGeo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvGeoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp"
            android:text="Escribe al menos 3 letras para buscar."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGeoAll"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Ver todas las chambas de Ayacucho"
        app:cornerRadius="14dp" />
</LinearLayout>