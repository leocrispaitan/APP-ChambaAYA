<?xml version="1.0" encoding="utf-8"?>
<!-- Publicar: tres secciones (Publicar · Publicaciones · Solicitudes) con barra
     de pestañas de solo iconos, indicador animado y cambio por toque o deslizando. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootPublicar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.publish.FragmentoPublicar">

    <!-- Barra de pestañas. El padding superior se ajusta en código con el
         alto real de la barra de estado (WindowInsets), para que los iconos
         nunca queden debajo de la batería/señal/wifi. El 28dp es solo
         fallback para la vista previa. -->
    <LinearLayout
        android:id="@+id/barraTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingTop="28dp">

        <FrameLayout
            android:id="@+id/tabPublicar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/publicar_tab_publicar"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/iconoPublicar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_publicar" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabPublicaciones"
            android:layout_width="0dp"
            android:layout_height="49dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/publicar_tab_publicaciones"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconoPublicaciones"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_publicaciones" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabSolicitudes"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/publicar_tab_solicitudes"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/iconoSolicitudes"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_solicitudes" />
        </FrameLayout>
    </LinearLayout>

    <!-- Línea divisoria + indicador deslizante -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/profile_divider" />

        <View
            android:id="@+id/indicadorTab"
            android:layout_width="56dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:background="@color/profile_tab_active" />
    </FrameLayout>

    <com.proyecto.chambaya.ui.publish.ContenedorDeslizable
        android:id="@+id/contenedorSecciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/panelPublicar"
            layout="@layout/item_publicar_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- FASE 5 · Mis publicaciones: lista + vacío -->
        <FrameLayout
            android:id="@+id/panelPublicaciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMisPublicaciones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <ProgressBar
                android:id="@+id/progressMis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <include
                android:id="@+id/emptyMis"
                layout="@layout/item_publicar_vacio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <include
            android:id="@+id/panelSolicitudes"
            layout="@layout/item_publicar_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </com.proyecto.chambaya.ui.publish.ContenedorDeslizable>

</LinearLayout>
