<?xml version="1.0" encoding="utf-8"?>
<!-- FASE 7 (básica) — Bandeja simple de notificaciones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:id="@+id/layoutNotifHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="@string/sheet_notif_titulo"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnNotifReadAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sheet_notif_leidas"
            android:textColor="@color/brand_color"
            android:textSize="13sp"
            android:padding="8dp" />

        <!-- Eliminar todas (con confirmación) -->
        <ImageButton
            android:id="@+id/btnNotifDeleteAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar todas"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notif_delete"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Barra de selección múltiple (pulsación larga) -->
    <LinearLayout
        android:id="@+id/layoutNotifSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnSelBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancelar selección"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvSelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            tools:text="1 seleccionada" />

        <TextView
            android:id="@+id/btnSelAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sheet_notif_todo"
            android:textColor="@color/brand_color"
            android:textSize="14sp"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/btnSelRead"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Marcar como leídas"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/brand_color" />

        <ImageButton
            android:id="@+id/btnSelDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar seleccionadas"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notif_delete"
            android:tint="#EF4444" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxHeight="420dp" />

    <ProgressBar
        android:id="@+id/progressNotif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNotifEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/sheet_notif_vacio1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
