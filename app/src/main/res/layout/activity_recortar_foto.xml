<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:fitsSystemWindows="true">

    <!-- ═══════════════════════════════════════════════
         BARRA SUPERIOR
    ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/barraSuperiorRecorte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCerrarRecorte"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recorte_foto_cerrar"
            android:padding="11dp"
            android:src="@drawable/ic_cerrar_recorte"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/recorte_foto_titulo"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Píldora con la instrucción: dice qué va a pasar si toca fuera. -->
    <TextView
        android:id="@+id/tvPistaRecorte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pista_recorte"
        android:fontFamily="sans-serif"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="@string/recorte_foto_pista"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperiorRecorte" />

    <!-- ═══════════════════════════════════════════════
         ÁREA DE RECORTE
    ═══════════════════════════════════════════════ -->
    <com.proyecto.chambaya.ui.foto.VistaRecorte
        android:id="@+id/vistaRecorte"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/barraInferiorRecorte"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPistaRecorte" />

    <ProgressBar
        android:id="@+id/progressRecorte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/vistaRecorte"
        app:layout_constraintEnd_toEndOf="@id/vistaRecorte"
        app:layout_constraintStart_toStartOf="@id/vistaRecorte"
        app:layout_constraintTop_toTopOf="@id/vistaRecorte" />

    <!-- ═══════════════════════════════════════════════
         BARRA INFERIOR
    ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/barraInferiorRecorte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#0B0B0F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotarRecorte"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/recorte_foto_rotar"
            android:textColor="#FFFFFF"
            app:icon="@drawable/ic_rotar"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="#FFFFFF"
            tools:ignore="ButtonStyle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestablecerRecorte"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/recorte_foto_restablecer"
            android:textColor="#94A3B8"
            tools:ignore="ButtonStyle" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAplicarRecorte"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="26dp"
            android:text="@string/recorte_foto_aplicar"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:backgroundTint="@color/brand_color"
            app:cornerRadius="26dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
