<?xml version="1.0" encoding="utf-8"?>
<!--
    actividad_splash.xml — Splash moderno sobre blanco:
    logo con halo, wordmark bicolor (navy + brand) en Sora Bold,
    eslogan en versalitas y detalle decorativo sutil.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    tools:context=".SplashActivity">

    <!-- Detalle decorativo superior (círculo tenue, no interfiere) -->
    <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="-70dp"
        android:layout_marginEnd="-60dp"
        android:alpha="0.55"
        android:background="@drawable/bg_splash_halo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Detalle decorativo inferior -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginStart="-90dp"
        android:layout_marginBottom="-100dp"
        android:alpha="0.4"
        android:background="@drawable/bg_splash_halo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/splashCenterGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44">

        <!-- Logo sobre halo claro con sombra suave -->
        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_splash_halo" />

            <ImageView
                android:id="@+id/imgSplashLogo"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo" />
        </FrameLayout>

        <!-- Wordmark bicolor con Sora Bold -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_bold"
                android:text="Chamb"
                android:textColor="@color/text_primary"
                android:textSize="42sp"
                android:letterSpacing="-0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_bold"
                android:text="AYA"
                android:textColor="@color/brand_color"
                android:textSize="42sp"
                android:letterSpacing="-0.01" />
        </LinearLayout>

        <!-- Eslogan en versalitas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/splash_tagline"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.22"
            tools:text="EL TRABAJO TE ENCUENTRA" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarSplash"
        android:layout_width="30dp"
        android:layout_height="15dp"
        android:layout_marginBottom="52dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/anim_three_dots"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
