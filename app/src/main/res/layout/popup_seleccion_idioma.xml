<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_language_popup"
    android:elevation="8dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/optionSpanish"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/bg_language_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/lang_spanish"
            android:src="@drawable/ic_flag_spain" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSpanishName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/lang_spanish_native"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSpanishLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/lang_spanish"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheckSpanish"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/lang_selected"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/optionEnglish"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/bg_language_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/lang_english"
            android:src="@drawable/ic_flag_united_kingdom" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEnglishName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/lang_english_native"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvEnglishLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/lang_english"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheckEnglish"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/lang_selected"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/optionQuechua"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/bg_language_option"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/lang_quechua"
            android:src="@drawable/ic_flag_peru" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQuechuaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/lang_quechua_native"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvQuechuaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/lang_quechua"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheckQuechua"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/lang_selected"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
