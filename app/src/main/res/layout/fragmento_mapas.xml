<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF8F1"
    tools:context=".ui.map.FragmentoMapas">

    <!-- Guideline dividing Map visible area and Bottom Sheet (~50%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottomSheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.50" />

    <!-- 1. REAL MAP VIEW (Full Screen - covers 100% of display) -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Property Preview Overlay (Active Villa Card & Pin) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/propertyOverlayContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineBottomSheet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Active Radar Location Dot (under pin tip) -->
        <View
            android:id="@+id/radarDot"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_map_radar_dot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Main House Pin (Forest Green Teardrop with White House Icon) -->
        <ImageView
            android:id="@+id/ivMainHousePin"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginBottom="-14dp"
            android:src="@drawable/ic_map_main_pin"
            app:layout_constraintBottom_toTopOf="@+id/radarDot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription" />

        <!-- Floating Active Property Card (Modern Family Villa / $1,250,000) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActivePlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="7dp"
            app:strokeColor="#18000000"
            app:strokeWidth="0.8dp"
            app:layout_constraintBottom_toTopOf="@+id/ivMainHousePin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <!-- Villa preview thumbnail with rounded corners -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivVillaThumb"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_modern_villa"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.VillaThumb" />

                <!-- Villa Title & Price Column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/map_villa_title"
                        android:textColor="@color/map_text_title"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/map_villa_price"
                        android:textColor="@color/map_text_title"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Chevron Right -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron_right"
                    tools:ignore="ContentDescription" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Action: Expand/Collapse Bottom Sheet Button (Top Right) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnToggleBottomSheet"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="72dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivToggleSheetIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_collapse_sheet"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action: My Location (GPS) Button (Top Right below Toggle) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnMyLocation"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="126dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_my_location"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. TOP HEADER (Overlays the Map) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Location Title and Address Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="-0.01"
                android:text="@string/map_title_location"
                android:textColor="@color/map_text_title"
                android:textSize="18.5sp" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/map_subtitle_address"
                android:textColor="@color/map_text_sub"
                android:textSize="13sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. BOTTOM SHEET ("WHAT'S NEARBY") -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomSheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="16dp"
        app:cardPreventCornerOverlap="false"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BottomSheetTopRounded"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineBottomSheet">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Drag Handle Bar -->
                <View
                    android:id="@+id/viewDragHandle"
                    android:layout_width="40dp"
                    android:layout_height="4.5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_bottom_sheet_handle" />

                <!-- Section Title: "What's Nearby" -->
                <TextView
                    android:id="@+id/tvWhatsNearbyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="-0.02"
                    android:text="@string/map_whats_nearby"
                    android:textColor="@color/map_text_title"
                    android:textSize="20sp" />

                <!-- Section Subtitle: "Everything you need, close to home" -->
                <TextView
                    android:id="@+id/tvWhatsNearbySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/map_whats_nearby_subtitle"
                    android:textColor="@color/map_text_sub"
                    android:textSize="13.5sp" />

                <!-- 4 Quick Category Cards in Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <!-- Category 1: Schools -->
                    <LinearLayout
                        android:id="@+id/catSchools"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_map_category_chip"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_pin_school"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-bold"
                            android:maxLines="1"
                            android:text="@string/map_cat_schools"
                            android:textColor="@color/map_text_title"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/map_cat_schools_dist"
                            android:textColor="#374151"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/map_cat_schools_count"
                            android:textColor="@color/map_text_sub"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Category 2: Shopping -->
                    <LinearLayout
                        android:id="@+id/catShopping"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_map_category_chip"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_pin_shopping"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-bold"
                            android:maxLines="1"
                            android:text="@string/map_cat_shopping"
                            android:textColor="@color/map_text_title"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/map_cat_shopping_dist"
                            android:textColor="#374151"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/map_cat_shopping_count"
                            android:textColor="@color/map_text_sub"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Category 3: Parks -->
                    <LinearLayout
                        android:id="@+id/catParks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_map_category_chip"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_pin_park"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-bold"
                            android:maxLines="1"
                            android:text="@string/map_cat_parks"
                            android:textColor="@color/map_text_title"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/map_cat_parks_dist"
                            android:textColor="#374151"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/map_cat_parks_count"
                            android:textColor="@color/map_text_sub"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Category 4: Restaurants -->
                    <LinearLayout
                        android:id="@+id/catRestaurants"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_map_category_chip"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_pin_coffee"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-bold"
                            android:maxLines="1"
                            android:text="@string/map_cat_restaurants"
                            android:textColor="@color/map_text_title"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/map_cat_restaurants_dist"
                            android:textColor="#374151"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/map_cat_restaurants_count"
                            android:textColor="@color/map_text_sub"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Nearby Places List -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">

                    <!-- Place Item 1: Griffith Park -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPlaceGriffith"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#F1F5F9"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <!-- Image Preview -->
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPlaceGriffith"
                                android:layout_width="72dp"
                                android:layout_height="54dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_griffith_park"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.PlaceThumb" />

                            <!-- Title & Category -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/map_place_griffith_title"
                                    android:textColor="@color/map_text_title"
                                    android:textSize="15sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/map_place_griffith_type"
                                    android:textColor="@color/map_text_sub"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Distance -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/map_place_griffith_dist"
                                android:textColor="#475569"
                                android:textSize="13sp" />

                            <!-- Chevron -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_chevron_right"
                                tools:ignore="ContentDescription" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Place Item 2: The Grove -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPlaceGrove"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#F1F5F9"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <!-- Image Preview -->
                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPlaceGrove"
                                android:layout_width="72dp"
                                android:layout_height="54dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_the_grove"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.PlaceThumb" />

                            <!-- Title & Category -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/map_place_grove_title"
                                    android:textColor="@color/map_text_title"
                                    android:textSize="15sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/map_place_grove_type"
                                    android:textColor="@color/map_text_sub"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Distance -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/map_place_grove_dist"
                                android:textColor="#475569"
                                android:textSize="13sp" />

                            <!-- Chevron -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_chevron_right"
                                tools:ignore="ContentDescription" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>