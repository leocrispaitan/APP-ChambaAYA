<?xml version="1.0" encoding="utf-8"?>
<!--
    item_banner_promo.xml — Página del carrusel de banners del home.
    Mismo diseño que el banner principal (fondo oscuro + degradado,
    columna de texto + CTA). El FragmentoChambas lo muestra en un
    ViewPager2 con 2 páginas fijas: Empleos y Tiempo libre.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Recorte centrado para conservar la proporción de las fotos horizontales. -->
        <ImageView
            android:id="@+id/ivBannerBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Degradado superpuesto (izquierda oscuro → transparente derecha) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_banner_gradient" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Columna izquierda: texto -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvBannerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_white"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/home_banner_badge"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    tools:text="Ayacucho · Verificadas" />

                <TextView
                    android:id="@+id/tvBannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/feed_banner_chambas_titulo"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.1"
                    tools:text="Chambas cerca de ti" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvBannerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/pub_encuentra_zona"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        tools:text="Encuentra oportunidades en tu zona." />

                    <TextView
                        android:id="@+id/tvBannerCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-black"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        tools:text="12" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBannerLegal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/home_banner_legal"
                    android:textColor="#99FFFFFF"
                    android:textSize="9sp"
                    android:layout_marginTop="4dp"
                    tools:text="Solo contratantes verificados · Pago en soles" />
            </LinearLayout>

            <!-- Columna derecha: CTA alineado abajo -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9">

                <Button
                    android:id="@+id/btnBannerCta"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_btn_claim"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/home_banner_cta"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:stateListAnimator="@null"
                    tools:text="Explorar" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
