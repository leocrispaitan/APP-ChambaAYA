<?xml version="1.0" encoding="utf-8"?>
<!--
    item_job_card.xml — Tarjeta de oferta de trabajo estilo publicación de Instagram
    Diseño optimizado para RecyclerView, 1 tarjeta por fila (full-width)
    Rediseñado siguiendo las instrucciones de instrucciones-rediseño.md
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJob"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════════
             CABECERA — 
             (Avatar + Nombre + Ubicación + Postular + ⋮)
             ══════════════════════════════════════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <!-- Foto de perfil circular con borde de gradiente -->
            <FrameLayout
                android:id="@+id/frameAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Anillo gradiente alrededor del avatar (estilo Instagram stories) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_circle" />

                <!-- Foto de perfil (círculo interior) -->
                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_profile_circle"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de perfil"
                    tools:src="@drawable/ic_nav_profile" />
            </FrameLayout>

            <!-- Nombre + Verificado + Ubicación + Tiempo -->
            <LinearLayout
                android:id="@+id/llUserInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/frameAvatar"
                app:layout_constraintEnd_toStartOf="@id/btnPostular"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Fila: Nombre de perfil + ícono verificado -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1A1A1A"
                        android:textSize="13.5sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Juan Quispe" />

                    <!-- Ícono verificado azul -->
                    <ImageView
                        android:id="@+id/ivVerified"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_verified"
                        android:contentDescription="Verificado" />
                </LinearLayout>

                <!-- Fila: Distrito + Tiempo transcurrido -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="1dp">

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="#888888"
                        android:textSize="11.5sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Ayacucho Centro" />

                    <!-- Separador punto -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · "
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTimeAgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        tools:text="Hace 2h" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botón "Postular" (reemplaza "Seguir") -->
            <TextView
                android:id="@+id/btnPostular"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_postular_btn"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Postular"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@id/btnMoreOptions"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Menú tres puntos ⋮ -->
            <ImageButton
                android:id="@+id/btnMoreOptions"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vertical"
                android:contentDescription="Más opciones"
                android:scaleType="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ══════════════════════════════════════════
             CONTENIDO: Nombre + Descripción del trabajo
             ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- Título / nombre del puesto + descripción corta -->
            <TextView
                android:id="@+id/tvJobDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="#1A1A1A"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Se necesita ayudante de albañilería para obra en Ayacucho Centro. Experiencia mínima 1 año." />

            <!-- Botón Ver más para la descripción -->
            <TextView
                android:id="@+id/btnVerMas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Ver más"
                android:textColor="#888888"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════
             IMAGEN PRINCIPAL DEL TRABAJO (full-width)
             Ocupa el ancho completo como post de Instagram
             ══════════════════════════════════════════ -->
        <FrameLayout
            android:id="@+id/frameJobImage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@drawable/bg_job_image_placeholder">

            <!-- Imagen del trabajo (se carga dinámicamente) -->
            <ImageView
                android:id="@+id/ivJobImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Imagen del trabajo"
                android:visibility="gone"
                tools:visibility="visible"
                tools:src="@drawable/bg_job_image_placeholder" />

            <!-- Vista alternativa cuando no hay imagen: tarjeta de info limpia -->
            <LinearLayout
                android:id="@+id/layoutJobInfoCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="visible">

                <!-- Ícono grande de categoría -->
                <ImageView
                    android:id="@+id/ivCategoryIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Categoría"
                    android:alpha="0.9"
                    tools:src="@drawable/ic_cat_construccion" />

                <!-- Título del puesto -->
                <TextView
                    android:id="@+id/tvJobTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#44000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    tools:text="Maestro Albañil" />

                <!-- Categoría badge -->
                <TextView
                    android:id="@+id/tvJobCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_white"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    tools:text="Construcción" />

                <!-- Sueldo destacado -->
                <TextView
                    android:id="@+id/tvJobPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFD700"
                    android:textSize="28sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    tools:text="S/ 80 / día" />

            </LinearLayout>

            <!-- Degradado inferior para legibilidad del texto -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_banner_gradient" />

        </FrameLayout>

        <!-- ══════════════════════════════════════════
             BARRA DE INTERACCIONES (estilo Instagram)
             Corazón + Counter · Comentario + Counter · Compartir + Counter | Guardar
             ══════════════════════════════════════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <!-- Grupo izquierdo: Me gusta + Comentarios + Compartir (con contadores a la derecha) -->
            <LinearLayout
                android:id="@+id/llActionsLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- 1. Botón + Contador Corazón (Me gusta / favorito) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginEnd="12dp">

                    <ImageButton
                        android:id="@+id/btnFavorite"
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_heart_outline"
                        android:contentDescription="Me gusta"
                        android:scaleType="center" />

                    <TextView
                        android:id="@+id/tvLikesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1A1A1A"
                        android:textSize="12.5sp"
                        tools:text="3.4k" />
                </LinearLayout>

                <!-- 2. Botón + Contador Comentario -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginEnd="12dp">

                    <ImageButton
                        android:id="@+id/btnComment"
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_comment"
                        android:contentDescription="Comentarios"
                        android:scaleType="center" />

                    <TextView
                        android:id="@+id/tvCommentsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1A1A1A"
                        android:textSize="12.5sp"
                        tools:text="133" />
                </LinearLayout>

                <!-- 3. Botón + Contador Compartir -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginEnd="8dp">

                    <ImageButton
                        android:id="@+id/btnShare"
                        android:layout_width="32dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_share"
                        android:contentDescription="Compartir"
                        android:scaleType="center" />

                    <TextView
                        android:id="@+id/tvSharesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1A1A1A"
                        android:textSize="12.5sp"
                        tools:text="4.1k" />
                </LinearLayout>

            </LinearLayout>

            <!-- Botón guardar (bookmark) a la derecha -->
            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark_outline"
                android:contentDescription="Guardar"
                android:scaleType="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ══════════════════════════════════════════
             PIE DE TARJETA — Rating con estrella
             ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- Rating con estrella -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvJobRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    tools:text="4.8 · Hace 8 horas" />
            </LinearLayout>

        </LinearLayout>

        <!-- Línea divisora entre tarjetas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.7dp"
            android:background="#E8E8E8" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
