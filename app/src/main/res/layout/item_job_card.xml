<?xml version="1.0" encoding="utf-8"?>
<!--
    item_job_card.xml — Layout individual para cada Card de Chamba
    Diseño optimizado para RecyclerView con rendimiento mejorado
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJob"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Imagen de la chamba (con color de fondo dinámico) -->
        <FrameLayout
            android:id="@+id/frameJobImage"
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <!-- Icono grande de categoría centrado -->
            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:src="@drawable/ic_cat_construccion" />

            <!-- Corazón favorito -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@null"
                android:src="@drawable/ic_heart_outline"
                android:contentDescription="Guardar"
                android:scaleType="center" />
        </FrameLayout>

        <!-- Info del trabajo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Título del trabajo -->
            <TextView
                android:id="@+id/tvJobTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Maestro Albañil" />

            <!-- Rating -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvJobRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    tools:text="4.8" />
            </LinearLayout>

            <!-- Precio -->
            <TextView
                android:id="@+id/tvJobPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_color"
                android:textSize="12sp"
                tools:text="S/ 80/día" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
