<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.profile.FragmentoMiPerfil">

        <!-- Deep Cosmic Purple Curved Header Graphic -->
        <ImageView
            android:id="@+id/ivHeaderBackground"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/bg_profile_header_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header Top Navigation Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="42dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_circle_btn"
                android:clickable="true"
                android:contentDescription="@string/auth_back"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_arrow_back" />
            </FrameLayout>

            <!-- Screen Title "Profile" -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/profile_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <!-- Settings Button -->
            <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_circle_btn"
                android:clickable="true"
                android:contentDescription="Settings"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_settings" />
            </FrameLayout>

            <!-- Privacy / Hide Mode Button -->
            <FrameLayout
                android:id="@+id/btnPrivacy"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_profile_circle_btn"
                android:clickable="true"
                android:contentDescription="Privacy"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSettings"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_eye_slash" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Avatar Container with Glowing Gradient Ring -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="142dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivHeaderBackground">

            <!-- Glowing Ring -->
            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:contentDescription="@null"
                android:src="@drawable/bg_profile_avatar_ring" />

            <!-- Circular Avatar Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="Profile Photo"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_katty"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

        </FrameLayout>

        <!-- "67% Complete" Pill Badge overlapping bottom of avatar -->
        <TextView
            android:id="@+id/tvCompletionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-11dp"
            android:background="@drawable/bg_profile_complete_badge"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp"
            android:text="@string/profile_completion_mock"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/avatarContainer"
            app:layout_constraintStart_toStartOf="@id/avatarContainer"
            app:layout_constraintTop_toBottomOf="@id/avatarContainer" />

        <!-- User Name & Verified Scalloped Badge -->
        <LinearLayout
            android:id="@+id/layoutName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCompletionBadge">

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/profile_name_mock"
                android:textColor="@color/profile_text_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivVerifiedBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Verified"
                android:src="@drawable/ic_profile_verified_badge" />

        </LinearLayout>

        <!-- User Handle -->
        <TextView
            android:id="@+id/tvProfileHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="@string/profile_handle_mock"
            android:textColor="@color/profile_text_handle"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutName" />

        <!-- Stats Counter Row (230 Posts | 890 Following | 120K Follower) -->
        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvProfileHandle">

            <!-- Posts Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/profile_posts_count"
                    android:textColor="@color/profile_text_stat_num"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/profile_posts_label"
                    android:textColor="@color/profile_text_stat_label"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider 1 -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@color/profile_divider" />

            <!-- Following Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFollowingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/profile_following_count"
                    android:textColor="@color/profile_text_stat_num"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/profile_following_label"
                    android:textColor="@color/profile_text_stat_label"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider 2 -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@color/profile_divider" />

            <!-- Follower Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFollowersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/profile_followers_count"
                    android:textColor="@color/profile_text_stat_num"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/profile_followers_label"
                    android:textColor="@color/profile_text_stat_label"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons Row (Follow | Message | Email) -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutStats">

            <!-- Follow Gradient Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFollow"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.05"
                android:background="@drawable/bg_profile_btn_follow"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/profile_btn_follow"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Message Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMessage"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/profile_btn_message"
                android:textAllCaps="false"
                android:textColor="@color/profile_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Email Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEmail"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/profile_btn_email"
                android:textAllCaps="false"
                android:textColor="@color/profile_btn_text"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Scrollable Content Section: Skills & Experience -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollProfileContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutActionButtons">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- Card 1: Skills Section -->
                <LinearLayout
                    android:id="@+id/cardSkills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_profile_section_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Skills Header: Circle Icon + Title + Subtitle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Solid Purple Circle with Lightning Bolt -->
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_profile_icon_circle_purple">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_profile_skills_zap" />
                        </FrameLayout>

                        <!-- Title & Subtitle -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/profile_skills_title"
                                android:textColor="#111827"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/profile_skills_subtitle"
                                android:textColor="#6B7280"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 4 Skills Horizontal Tiles -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Skill 1: Figma -->
                        <LinearLayout
                            android:id="@+id/skillFigma"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_profile_skill_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="28dp"
                                android:contentDescription="@string/profile_skill_figma"
                                android:src="@drawable/ic_skill_figma" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/profile_skill_figma"
                                android:textColor="#1F2937"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Skill 2: Adobe XD -->
                        <LinearLayout
                            android:id="@+id/skillAdobeXd"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_profile_skill_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:contentDescription="@string/profile_skill_adobexd"
                                android:src="@drawable/ic_skill_adobexd" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/profile_skill_adobexd"
                                android:textColor="#1F2937"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Skill 3: Sketch -->
                        <LinearLayout
                            android:id="@+id/skillSketch"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_profile_skill_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:contentDescription="@string/profile_skill_sketch"
                                android:src="@drawable/ic_skill_sketch" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/profile_skill_sketch"
                                android:textColor="#1F2937"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Skill 4: InVision -->
                        <LinearLayout
                            android:id="@+id/skillInVision"
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_profile_skill_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:contentDescription="@string/profile_skill_invision"
                                android:src="@drawable/ic_skill_invision" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/profile_skill_invision"
                                android:textColor="#1F2937"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Card 2: Experience Section -->
                <LinearLayout
                    android:id="@+id/cardExperience"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_profile_section_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Experience Header: Circle Icon + Title + Subtitle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Solid Purple Circle with Briefcase -->
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_profile_icon_circle_purple">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_profile_exp_briefcase" />
                        </FrameLayout>

                        <!-- Title & Subtitle -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/profile_experience_title"
                                android:textColor="#111827"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/profile_experience_subtitle"
                                android:textColor="#6B7280"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Experience Timeline Items -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <!-- Vertical Timeline Line -->
                        <View
                            android:id="@+id/timelineLine"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:background="#E2E8F0"
                            app:layout_constraintBottom_toBottomOf="@id/expItem2"
                            app:layout_constraintEnd_toEndOf="@id/dotExp1"
                            app:layout_constraintStart_toStartOf="@id/dotExp1"
                            app:layout_constraintTop_toTopOf="@id/dotExp1" />

                        <!-- Dot 1 for Art Director -->
                        <View
                            android:id="@+id/dotExp1"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_profile_timeline_dot"
                            app:layout_constraintBottom_toBottomOf="@id/expItem1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/expItem1" />

                        <!-- Experience Item 1: Art Director -->
                        <LinearLayout
                            android:id="@+id/expItem1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/bg_profile_exp_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/dotExp1"
                            app:layout_constraintTop_toTopOf="parent">

                            <!-- Palette Icon Container -->
                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_profile_exp_icon_palette">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_exp_art_palette" />
                            </FrameLayout>

                            <!-- Title & Company -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/profile_exp_art_director_title"
                                    android:textColor="#111827"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/profile_exp_art_director_company"
                                    android:textColor="#6B7280"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Date -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/profile_exp_art_director_date"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Dot 2 for Designer -->
                        <View
                            android:id="@+id/dotExp2"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_profile_timeline_dot"
                            app:layout_constraintBottom_toBottomOf="@id/expItem2"
                            app:layout_constraintEnd_toEndOf="@id/dotExp1"
                            app:layout_constraintStart_toStartOf="@id/dotExp1"
                            app:layout_constraintTop_toTopOf="@id/expItem2" />

                        <!-- Experience Item 2: Designer -->
                        <LinearLayout
                            android:id="@+id/expItem2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_profile_exp_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/dotExp1"
                            app:layout_constraintTop_toBottomOf="@id/expItem1">

                            <!-- Desktop Monitor Icon Container -->
                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_profile_exp_icon_desktop">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_exp_desktop" />
                            </FrameLayout>

                            <!-- Title & Company -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/profile_exp_designer_title"
                                    android:textColor="#111827"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/profile_exp_designer_company"
                                    android:textColor="#6B7280"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Date -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/profile_exp_designer_date"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>