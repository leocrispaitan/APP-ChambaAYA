<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ChambAYA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_color</item>
        <item name="colorPrimaryDark">@color/brand_color</item>
        <item name="colorSecondary">@color/brand_color</item>
        <item name="android:statusBarColor">@color/brand_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:colorBackground">@color/background_light</item>
    </style>

    <style name="Theme.ChambAYA" parent="Base.Theme.ChambAYA" />

    <style name="Theme.ChambAYA.Splash" parent="Theme.ChambAYA">
        <item name="android:windowBackground">@drawable/window_bg_as_splash</item>
    </style>

    <!-- Bottom Navigation Style (ChambAYA-APP) -->
    <style name="Widget.ChambAYA.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemBackground">@null</item>
        <item name="itemIconTint">@color/bottom_nav_icon_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">4dp</item>
        <item name="activeIndicatorLabelPadding">4dp</item>
        <item name="itemRippleColor">@color/bottom_nav_ripple_selector</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.ChambAYA.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.ChambAYA.BottomNav.Inactive</item>
        <item name="itemTextAppearanceActiveBoldEnabled">true</item>
        <item name="labelMaxLines">1</item>
        <item name="elevation">12dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.ChambAYA.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.ChambAYA.BottomNav.ActiveIndicator" parent="">
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ChambAYA.BottomNav.ActiveIndicator</item>
        <item name="android:color">@color/brand_container</item>
    </style>

    <style name="ShapeAppearance.ChambAYA.BottomNav.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="TextAppearance.ChambAYA.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ChambAYA.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Map Shape Appearances -->
    <style name="ShapeAppearance.BottomSheetTopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">30dp</item>
        <item name="cornerSizeTopRight">30dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.VillaThumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.PlaceThumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Logout / Settings Dialog Animation -->
    <style name="DialogSlideUpAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_up</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_down</item>
    </style>

    <!-- Custom DatePicker Theme -->
    <style name="CustomDatePickerTheme" parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">#5B67F7</item>
        <item name="colorAccent">#5B67F7</item>
        <item name="android:textColorPrimary">#1F2937</item>
        <item name="android:textColorSecondary">#6B7280</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomDatePickerButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomDatePickerButton</item>
    </style>

    <style name="CustomDatePickerButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#5B67F7</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Custom AlertDialog Theme -->
    <style name="CustomAlertDialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="colorPrimary">#5B67F7</item>
        <item name="android:textColorPrimary">#1F2937</item>
        <item name="android:textColorSecondary">#6B7280</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:background">@android:color/white</item>
    </style>

    <style name="CustomAlertDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#5B67F7</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Edit Profile Activity Theme (Full screen with custom transitions) -->
    <style name="Theme.ChambAYA.EditProfile" parent="Theme.ChambAYA">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowAnimationStyle">@style/EditProfileAnimation</item>
    </style>

    <style name="EditProfileAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_up</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_down</item>
    </style>
</resources>