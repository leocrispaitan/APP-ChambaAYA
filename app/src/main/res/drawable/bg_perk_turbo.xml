<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1A7C3AED">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F5EFFE"
                android:endColor="#ECE1FD"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#E2D4F7" />
        </shape>
    </item>
</ripple>
