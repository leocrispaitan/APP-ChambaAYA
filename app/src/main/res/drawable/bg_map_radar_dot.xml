<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer light blue translucent aura / ripple -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#4D3B82F6" />
        </shape>
    </item>

    <!-- Inner solid blue location dot with white border -->
    <item
        android:width="14dp"
        android:height="14dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#2563EB" />
            <stroke
                android:width="2.5dp"
                android:color="@color/white" />
        </shape>
    </item>
</layer-list>
