<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1A0D9488">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#EAFBF9"
                android:endColor="#D5F5F0"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#BEEBE4" />
        </shape>
    </item>
</ripple>
