<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChambAYA"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ChambAYA.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".BienvenidaActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.chat.ActividadChatDetalle"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EditarPerfilActivity"
            android:exported="false"
            android:theme="@style/Theme.ChambAYA.EditProfile"
            android:windowSoftInputMode="adjustResize" />

        <!-- FASE 4 — Crear / editar el lugar del contratante. Mismo tema y
             ajuste de teclado que el resto de formularios. -->
        <activity
            android:name=".ui.workplace.EditarLugarActivity"
            android:exported="false"
            android:theme="@style/Theme.ChambAYA.EditProfile"
            android:windowSoftInputMode="adjustResize" />

        <!-- FASE 5 — Crear / editar publicación. Mismo tema y
             ajuste de teclado que el resto de formularios. -->
        <activity
            android:name=".ui.publish.CrearPublicacionActivity"
            android:exported="false"
            android:theme="@style/Theme.ChambAYA.EditProfile"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ajuste de la foto de perfil. Va aparte del wizard y con tema
             propio (oscuro) porque el recorte se hace con un velillo negro
             alrededor del círculo. -->
        <activity
            android:name=".ui.foto.RecortarFotoActivity"
            android:exported="false"
            android:theme="@style/Theme.ChambAYA.RecorteFoto" />

        <!-- Pantalla completa de idiomas (solo diseño). -->
        <activity
            android:name=".ActividadIdioma"
            android:exported="false" />
    </application>

</manifest>