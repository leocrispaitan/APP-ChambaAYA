# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - BACKEND CHAMBAYA (FASE 3)
# ==============================================================================
# Copia este archivo a `.env` dentro de la carpeta `functions/` o configúralo en:
# Firebase Console -> Functions -> Secret Manager / Variables de entorno
#
# Servicio de Correo Transaccional Recomendado: Resend (https://resend.com)
# Plan Gratuito: 3,000 correos/mes (100 correos/día), sin tarjeta obligatoria.
# ==============================================================================

# API Key de Resend (obtenida en https://resend.com/api-keys)
RESEND_API_KEY=re_tu_api_key_aqui

# Remitente de correo. Durante pruebas con Resend puedes usar el dominio por defecto:
# ChambAYA <onboarding@resend.dev>
# En producción con dominio propio configurado: ChambAYA <seguridad@chambaya.pe>
RESEND_FROM_EMAIL=ChambAYA <onboarding@resend.dev>

# Sal secreta para el hash seguro de OTP en backend (evita ataques por tablas precomputadas)
OTP_SALT=chambaya_secure_otp_salt_2026_super_secret

# (Opcional) Configuración alternativa con SMTP estándar si se prefiere Nodemailer:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu_password_de_aplicacion
