rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    //  Helpers FASE 1
    // =============================================================

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidRole(role) {
      return role is string && role in ['TRABAJADOR', 'CONTRATANTE'];
    }

    function isValidDocumentType(documentType) {
      return documentType is string && documentType in ['DNI', 'RUC'];
    }

    // DNI = 8 dígitos, RUC = 11 dígitos
    function isValidDocumentNumber(documentType, documentNumber) {
      return documentNumber is string
        && ((documentType == 'DNI' && documentNumber.matches('^[0-9]{8}$'))
          || (documentType == 'RUC' && documentNumber.matches('^[0-9]{11}$')));
    }

    // Bloque `identity` de `users/{uid}` (FASE 1)
    function hasValidIdentity() {
      let identity = request.resource.data.identity;
      return identity is map
        && identity.keys().hasAll([
             'documentType',
             'documentNumber',
             'documentNumberMasked',
             'identityVerified',
             'verifiedWith',
             'identityName',
             'verifiedAt'
           ])
        && isValidDocumentType(identity.documentType)
        && isValidDocumentNumber(identity.documentType, identity.documentNumber)
        && identity.documentNumberMasked is string
        && identity.documentNumberMasked.size() > 0
        && identity.identityVerified == true
        && identity.verifiedWith in ['RENIEC', 'SUNAT']
        && identity.identityName is string
        && identity.identityName.size() > 2
        && identity.verifiedAt != null;
    }

    // Bloque `auth` de `users/{uid}` (FASE 1). Nunca se guarda contraseña.
    function hasValidAuthBlock() {
      let authData = request.resource.data.auth;
      return authData is map
        && authData.keys().hasAll(['provider', 'email', 'emailVerified'])
        && authData.provider in ['EMAIL', 'GOOGLE']
        && authData.email is string
        && authData.email.size() > 3
        && authData.emailVerified == true;
    }

    // `roles` / `activeRole` deben ser coherentes entre sí.
    function hasValidRoles() {
      let roles = request.resource.data.roles;
      return roles is list
        && roles.size() >= 1
        && roles.size() <= 2
        && roles.hasOnly(['TRABAJADOR', 'CONTRATANTE'])
        && isValidRole(request.resource.data.activeRole)
        && request.resource.data.activeRole in roles;
    }

    function isActiveAndVerified() {
      return request.resource.data.registrationStatus == 'VERIFIED'
        && request.resource.data.accountStatus == 'ACTIVE';
    }

    function isCompleteRegistration() {
      return request.resource.data.uid != null
        && isActiveAndVerified()
        && hasValidRoles()
        && hasValidAuthBlock()
        && hasValidIdentity();
    }

    // El documento de identidad solo se puede rellenar una vez.
    // Si ya existía, el número de documento no puede cambiar.
    function keepsDocumentNumber() {
      let oldIdentity = resource.data.identity;
      return !(oldIdentity is map)
        || oldIdentity.documentNumber == request.resource.data.identity.documentNumber;
    }

    // Campos que el usuario siempre puede tocar en su propio documento.
    function onlyAuditFieldsChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['updatedAt', 'lastLoginAt', 'lastSeenAt']);
    }

    // =============================================================
    //  Helpers FASE 2 — Mi Perfil
    // =============================================================
    //
    // El usuario puede escribir SOLO en:
    //   profile   -> datos que completan su perfil público
    //   worker    -> su parte editable (experiencia, especialidades, habilidades)
    //   privacy   -> qué muestra de su contacto
    //   updatedAt -> auditoría
    //
    // No puede tocar NUNCA: uid, auth, identity, roles, activeRole,
    // registrationStatus, accountStatus, emailVerified, otpVerified,
    // ni la reputación de worker (workCount / ratingAverage / ratingCount)
    // ni los contadores de statistics.

    // @usuario: 3-30 caracteres en minúsculas, sin espacios.
    function isValidUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 30
        && value.matches('^[a-z0-9._]+$');
    }

    // Teléfono: opcional, pero si se escribe tiene que ser un teléfono.
    //
    // No puede exigirse siempre: el registro de la FASE 1 no pide teléfono, así
    // que toda cuenta nace sin él. Si la regla rechazara el vacío, el usuario no
    // podría escribir NADA de la FASE 2 hasta ponerse un teléfono, y
    // `ensureProfileInitialized` (que escribe `phone: ""`) fallaría siempre.
    // El teléfono sube el porcentaje de completitud, pero no es obligatorio.
    function isValidPhone(value) {
      return value is string
        && (value.size() == 0
            || (value.size() >= 9
                && value.size() <= 20
                && value.matches('^[0-9+ ()-]+$')));
    }

    function isValidGender(value) {
      return value is string
        && (value == '' || value in ['MASCULINO', 'FEMENINO', 'OTRO']);
    }

    // Lista de textos cortos: tamaño acotado y longitud total acotada.
    // `join` exige elementos de texto, así que un mapa o un número metido en
    // la lista hace fallar la función y se deniega la escritura.
    function isValidStringList(value, maxItems, maxChars) {
      return value is list
        && value.size() <= maxItems
        && value.join(' ').size() <= maxChars;
    }

    // --- Foto de perfil -
    // Una foto nueva solo puede venir del módulo de avatares del propio usuario.
    // La app sube con `folder = chambaya/fotos-perfil/{uid}/profile` y Cloudinary
    // genera un nombre aleatorio dentro, así que la URL real es:
    //   https://res.cloudinary.com/<cloud>/image/upload/v1790543492
    //            /chambaya/fotos-perfil/{uid}/profile/ncr35rzw109sh9ykgagf.jpg
    // Si la foto no cambió se acepta la que haya (p. ej. la de Google que
    // dejó la FASE 1).
    //
    // OJO con el segmento `v1790543492`: es la versión del asset y Cloudinary lo
    // pone SIEMPRE en las URLs de entrega, así que tiene que admitirse. Y ojo con
    // el nivel extra tras el uid (`profile/<aleatorio>`): los dos se olvidaron
    // alguna vez y el síntoma era el mismo — la subida funcionaba, la imagen se
    // veía, y al pulsar "Finalizar" salía un PERMISSION_DENIED sin explicación.
    //
    // El patrón se ancla en `chambaya/fotos-perfil/{uid}/` y deja dos niveles
    // libres después, que es lo que permite renombrar la subcarpeta sin volver a
    // romper el guardado. Lo que NO se admite es salirse de la carpeta del propio
    // usuario.
    //
    // La carpeta debe ser la MISMA que devuelve `CloudinaryUploader.carpetaDePerfil`,
    // que es lo que la app escribe en `profile.profilePhotoPath`. Si se cambia una,
    // hay que cambiar las dos o el guardado se deniega sin motivo visible.
    function isOwnCloudinaryPhoto(uid) {
      let profile = request.resource.data.get('profile', '');
      return profile is map
        && profile.get('profilePhotoUrl', '') is string
        && profile.get('profilePhotoUrl', '').size() > 0
        && profile.get('profilePhotoUrl', '').matches(
             '^https://res\\.cloudinary\\.com/[^/]+/image/upload/(v[0-9]+/)?chambaya/fotos-perfil/' + uid + '/[^/]+/[^/]+$');
    }

    function photoUnchanged() {
      let before = resource.data.get('profile', '');
      let after = request.resource.data.get('profile', '');
      return before is map
        && after is map
        && before.get('profilePhotoUrl', '') == after.get('profilePhotoUrl', '')
        && before.get('profilePhotoPublicId', '') == after.get('profilePhotoPublicId', '');
    }

    // Detecta si esta escritura toca el bloque `profile`.
    //
    // OJO: no se usa `affectedData()`. En Rules `request.resource.data` SIEMPRE es
    // el documento completo después de la escritura, también cuando el cliente hizo
    // `update({'profile.photo': ...})`, así que `diff().affectedKeys()` ya devuelve
    // las claves de PRIMER nivel ('profile', 'worker', ...), no rutas con punto.
    // Por tanto `affectedKeys()` basta, y además es lo único fiable: el compilador
    // marca `affectedData()` como "Invalid function name", y una función que no
    // existe hace que la regla LANCE al evaluarse, lo que se traduce en un
    // `PERMISSION_DENIED` invisible en cualquier escritura de perfil.
    function photoBelongsToOwner(uid) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let tocaFoto = affected.hasAny(['profile']);
      return !tocaFoto || photoUnchanged() || isOwnCloudinaryPhoto(uid);
    }

    // --- Validación de lo que el usuario escribe -
    //
    // `worker`, `privacy` y `statistics` solo se validan si existen en el
    // documento resultante. Antes se exigían siempre, y eso rompía un caso
    // real: una cuenta que nunca pasó por "Mi Perfil" no tiene `statistics`, así
    // que guardar desde "Editar perfil" (que no lo escribe) se denegaba sin
    // motivo. `profile` sí o sí existe: lo crea el registro de la FASE 1.
    //
    // `profile.usernameNormalized` debe coincidir con `profile.username`:
    // es la misma clave que se reserva en `usernames/`.
    function isValidProfileUpdate() {
      let profile = request.resource.data.get('profile', '');
      return profile is map
        && isValidUsername(profile.get('username', ''))
        && profile.get('usernameNormalized', '') == profile.get('username', '')
        && isValidPhone(profile.get('phone', ''))
        && profile.get('bio', '') is string
        && profile.get('bio', '').size() <= 500
        && isValidGender(profile.get('gender', ''));
    }

    // El `&&` va antes de los `get()` a propósito: si `worker` no fuera un mapa,
    // Rules lanzaría un error de evaluación y la escritura se denegaría.
    function isValidWorkerUpdate() {
      let worker = request.resource.data.get('worker', '');
      return !(worker is map)
        || (worker.get('enabled', true) is bool
          && worker.get('experienceYears', 0) is number
          && worker.get('experienceYears', 0) >= 0
          && worker.get('experienceYears', 0) <= 70
          // Distingue "escribí 0 años" de "nunca toqué el campo". Sin esto, un
          // trabajador que empieza y no tiene experiencia no podía llegar nunca
          // al 100 %: el perfil se quedaba en 92 para siempre.
          && worker.get('experienceDeclared', false) is bool
          && isValidStringList(worker.get('specialties', []), 3, 180)
          && isValidStringList(worker.get('skills', []), 10, 600)
          && worker.get('profileCompleted', 0) is number
          && worker.get('profileCompleted', 0) >= 0
          && worker.get('profileCompleted', 0) <= 100);
    }

    function isValidPrivacyUpdate() {
      let privacy = request.resource.data.get('privacy', '');
      return !(privacy is map)
        || (privacy.get('showPhone', false) is bool
          && privacy.get('showEmail', false) is bool
          && privacy.get('showExactAddress', false) is bool);
    }


    // =============================================================
    //  FASE 3 — Perfil CONTRATANTE
    // =============================================================

    function isValidEmployerDocument(documentType, documentNumber) {
      return isValidDocumentNumber(documentType, documentNumber);
    }

    function isValidEmployerBlock() {
      let employer = request.resource.data.get('employer', '');
      return employer is map
        && employer.get('enabled', false) == true
        && employer.get('employerType', '') in ['PERSONA', 'EMPRESA', 'NEGOCIO', 'INDEPENDIENTE']
        && isValidDocumentType(employer.get('documentType', ''))
        && isValidEmployerDocument(
             employer.get('documentType', ''),
             employer.get('documentNumber', ''))
        && employer.get('businessName', '') is string
        && employer.get('businessName', '').size() >= 3
        && employer.get('businessName', '').size() <= 120
        && employer.get('commercialName', '') is string
        && employer.get('commercialName', '').size() <= 120
        && employer.get('sector', '') is string
        && employer.get('sector', '').size() <= 120
        && employer.get('documentNumber', '') is string
        && (
          (employer.get('documentType', '') == 'RUC'
            && employer.get('ruc', '') == employer.get('documentNumber', ''))
          || (employer.get('documentType', '') == 'DNI'
            && (employer.get('ruc', null) == null || employer.get('ruc', '') == ''))
        )
        && employer.get('identityName', '') is string
        && employer.get('identityName', '').size() >= 3
        // FASE 4 — enlace al lugar principal. Nulo = aún sin lugar.
        && (employer.get('workplaceId', null) == null
          || (employer.get('workplaceId', '') is string
            && employer.get('workplaceId', '').size() <= 80))
        && employer.get('publishedCount', 0) is number
        && employer.get('hiredCount', 0) is number
        && employer.get('ratingAverage', 0.0) is number
        && employer.get('ratingCount', 0) is number;
    }

    function keepsEmployerReputation() {
      let before = resource.data.get('employer', '');
      let after = request.resource.data.get('employer', '');
      return !(after is map)
        || (!(before is map)
          && after.get('publishedCount', 0) == 0
          && after.get('hiredCount', 0) == 0
          && after.get('ratingAverage', 0.0) == 0.0
          && after.get('ratingCount', 0) == 0)
        || (before is map
          && after.get('publishedCount', 0) == before.get('publishedCount', 0)
          && after.get('hiredCount', 0) == before.get('hiredCount', 0)
          && after.get('ratingAverage', 0.0) == before.get('ratingAverage', 0.0)
          && after.get('ratingCount', 0) == before.get('ratingCount', 0));
    }

    function validRoleListWithEmployer() {
      let roles = request.resource.data.get('roles', []);
      return roles is list
        && roles.size() == 2
        && roles.hasOnly(['TRABAJADOR', 'CONTRATANTE'])
        && request.resource.data.get('activeRole', '') == 'CONTRATANTE'
        && isValidEmployerBlock()
        && keepsEmployerReputation();
    }

    // Requisitos previos para activar contratante (FASE 3):
    // identidad verificada, correo verificado, perfil básico completo
    function hasContractorPrerequisites() {
      let identity = resource.data.get('identity', '');
      let auth = resource.data.get('auth', '');
      let profile = resource.data.get('profile', '');
      return identity is map
        && identity.get('identityVerified', false) == true
        && auth is map
        && auth.get('emailVerified', false) == true
        && profile is map
        && profile.get('fullName', '') is string
        && profile.get('fullName', '').size() > 0
        && profile.get('username', '') is string
        && profile.get('username', '').size() > 0
        && profile.get('phone', '') is string
        && profile.get('phone', '').size() > 0;
    }

    function isAllowedContractorActivation(uid) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roles', 'activeRole', 'employer', 'updatedAt'])
        && resource.data.roles is list
        && resource.data.roles.hasOnly(['TRABAJADOR'])
        && validRoleListWithEmployer()
        && hasContractorPrerequisites();
    }

    // Permitir actualizar employer cuando el usuario ya tiene ambos roles
    // (aunque activeRole sea TRABAJADOR): no es una activación nueva, solo
    // una edición de datos de contratante ya existente.
    function isAllowedEmployerUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['employer', 'updatedAt'])
        && resource.data.roles is list
        && resource.data.roles.hasOnly(['TRABAJADOR', 'CONTRATANTE'])
        && isValidEmployerBlock()
        && keepsEmployerReputation();
    }

    // Primera activación de TRABAJADOR en una cuenta que nació contratante.
    // Espejo de la activación de contratante: suma el rol y entra en ese modo.
    // El bloque `worker` nace en cero (o se habilita el existente) y la
    // reputación queda intacta; el % se recalcula solo con los checks de
    // trabajador.
    function isAllowedWorkerActivation() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roles', 'activeRole', 'worker', 'updatedAt'])
        && resource.data.roles is list
        && resource.data.roles.hasOnly(['CONTRATANTE'])
        && request.resource.data.roles.hasOnly(['TRABAJADOR', 'CONTRATANTE'])
        && request.resource.data.activeRole == 'TRABAJADOR'
        && request.resource.data.get('worker', '').get('enabled', false) == true
        && isValidWorkerUpdate()
        && keepsWorkerReputation();
    }

    function isAllowedActiveRoleSwitch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activeRole', 'updatedAt'])
        && request.resource.data.activeRole in request.resource.data.roles
        && request.resource.data.roles == resource.data.roles
        && (
          request.resource.data.activeRole == 'TRABAJADOR'
          || (
            request.resource.data.activeRole == 'CONTRATANTE'
            && request.resource.data.get('employer', '').get('enabled', false) == true
          )
        );
    }

    // =============================================================
    //  FASE 4 — Lugar / establecimiento (workplaces)
    // =============================================================
    //
    // Un contratante tiene UN lugar principal enlazado en
    // `users/{uid}.employer.workplaceId` (la Fase 5 lo usa como sede).
    // La foto es opcional; cuando hay, debe venir del módulo
    // `chambaya/fotos-lugares/{ownerUid}/` del propio dueño, igual que el
    // avatar exige `chambaya/fotos-perfil/{uid}/`.

    function isValidWorkplaceType(value) {
      return value is string && value in [
        'VIVIENDA', 'LOCAL_COMERCIAL', 'EMPRESA', 'TALLER',
        'RESTAURANTE', 'OBRA', 'CAMPO', 'OTRO'
      ];
    }

    function isValidWorkplaceLocation(loc) {
      return loc is map
        && (loc.get('latitude', null) == null || loc.get('latitude', 0) is number)
        && (loc.get('longitude', null) == null || loc.get('longitude', 0) is number)
        && (loc.get('latitude', null) == null || loc.get('longitude', null) == null
          || (loc.get('latitude', 0) >= -90 && loc.get('latitude', 0) <= 90
            && loc.get('longitude', 0) >= -180 && loc.get('longitude', 0) <= 180));
    }

    // Foto del lugar: vacía (lugar sin foto, válido) o URL de Cloudinary del
    // propio dueño con su publicId. El segmento `v123/` de versión se admite,
    // igual que en `isOwnCloudinaryPhoto`.
    function isOwnLugarPhoto(ownerUid) {
      return request.resource.data.get('photoUrl', '') is string
        && request.resource.data.get('photoUrl', '').size() > 0
        && request.resource.data.get('photoPublicId', '') is string
        && request.resource.data.get('photoPublicId', '').size() > 0
        && request.resource.data.get('photoUrl', '').matches(
             '^https://res\\.cloudinary\\.com/[^/]+/image/upload/(v[0-9]+/)?chambaya/fotos-lugares/' + ownerUid + '/[^/]+/[^/]+$');
    }

    function lugarPhotoOk(ownerUid) {
      let url = request.resource.data.get('photoUrl', '');
      let pid = request.resource.data.get('photoPublicId', '');
      return (url == '' && pid == '')
        || isOwnLugarPhoto(ownerUid);
    }

    // Campos editables comunes a crear y actualizar.
    function hasValidWorkplaceFields(ownerUid) {
      let d = request.resource.data;
      return d.get('name', '') is string
        && d.get('name', '').size() >= 3
        && d.get('name', '').size() <= 120
        && isValidWorkplaceType(d.get('type', ''))
        && d.get('sector', '') is string
        && d.get('sector', '').size() <= 120
        && d.get('description', '') is string
        && d.get('description', '').size() <= 1000
        && d.get('address', '') is string
        && d.get('address', '').size() <= 200
        && d.get('district', '') is string
        && d.get('district', '').size() <= 80
        && d.get('province', '') is string
        && d.get('province', '').size() <= 80
        && d.get('department', '') is string
        && d.get('department', '').size() <= 80
        && isValidWorkplaceLocation(d.get('location', {}))
        && d.get('photoPath', '') is string
        && lugarPhotoOk(ownerUid);
    }

    function isValidWorkplaceCreate(workplaceId) {
      let d = request.resource.data;
      return d.get('workplaceId', '') == workplaceId
        && d.get('ownerUid', '') == request.auth.uid
        && hasValidWorkplaceFields(d.get('ownerUid', ''))
        // Nadie se autoverifica: nace en false y solo la plataforma lo cambia.
        && d.get('verified', true) == false
        && d.get('createdAt', null) != null
        && d.get('updatedAt', null) != null;
    }

    function isValidWorkplaceUpdate() {
      let d = request.resource.data;
      return d.get('workplaceId', '') == resource.data.get('workplaceId', '')
        && d.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && hasValidWorkplaceFields(resource.data.get('ownerUid', ''))
        && d.get('verified', false) == resource.data.get('verified', false)
        && d.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // --- Reputación: intocable para el usuario -
    // `workCount`, `ratingAverage` y `ratingCount` los calcula la plataforma.
    // La primera vez que se crea el bloque tienen que valer cero; después
    // deben quedar exactamente como estaban.
    //
    // Si el bloque no existe en el documento resultante, la escritura no lo
    // tocó y no hay nada que proteger.
    function reputationIsZero(after) {
      return after is map
        && after.get('workCount', 0) == 0
        && after.get('ratingAverage', 0.0) == 0.0
        && after.get('ratingCount', 0) == 0;
    }

    function sameReputation(before, after) {
      return after is map
        && after.get('workCount', 0) == before.get('workCount', 0)
        && after.get('ratingAverage', 0.0) == before.get('ratingAverage', 0.0)
        && after.get('ratingCount', 0) == before.get('ratingCount', 0);
    }

    function keepsWorkerReputation() {
      let before = resource.data.get('worker', '');
      let after = request.resource.data.get('worker', '');
      return !(after is map)
        || (before is map && sameReputation(before, after))
        || (!(before is map) && reputationIsZero(after));
    }

    // Los contadores de `statistics` también los incrementa la plataforma:
    // en la FASE 2 únicamente se crean en cero.
    function statisticsAreZero(after) {
      return after is map
        && after.get('applicationsCount', 0) == 0
        && after.get('publicationsCount', 0) == 0
        && after.get('completedJobsCount', 0) == 0
        && after.get('savedPublicationsCount', 0) == 0
        && after.get('receivedRatingsCount', 0) == 0;
    }

    function sameStatistics(before, after) {
      return after is map
        && after.get('applicationsCount', 0) == before.get('applicationsCount', 0)
        && after.get('publicationsCount', 0) == before.get('publicationsCount', 0)
        && after.get('completedJobsCount', 0) == before.get('completedJobsCount', 0)
        && after.get('savedPublicationsCount', 0) == before.get('savedPublicationsCount', 0)
        && after.get('receivedRatingsCount', 0) == before.get('receivedRatingsCount', 0);
    }

    function createsZeroStatistics() {
      let before = resource.data.get('statistics', '');
      let after = request.resource.data.get('statistics', '');
      return !(after is map)
        || (before is map && sameStatistics(before, after))
        || (!(before is map) && statisticsAreZero(after));
    }

    // =============================================================
    //  FASE 5 — Contadores de publicaciones (denormalizados)
    // =============================================================
    //
    // Al crear/eliminar una publicación la app suma/resta 1 a
    // `employer.publishedCount` y `statistics.publicationsCount` (Mi Perfil los
    // muestra). Las ramas existentes lo impedirían: `keepsEmployerReputation`
    // y `createsZeroStatistics` exigen esos contadores intactos. Esta rama lo
    // permite SOLO cuando el único cambio es un paso de ±1 en esos dos
    // contadores: nadie puede inventarse reputación ni tocar nada más.
    function isAllowedPublicationCounterUpdate() {
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      let beforeEmp = resource.data.get('employer', '');
      let afterEmp = request.resource.data.get('employer', '');
      let beforeStat = resource.data.get('statistics', '');
      let afterStat = request.resource.data.get('statistics', '');
      return touched.hasOnly(['employer', 'statistics', 'updatedAt'])
        && beforeEmp is map && afterEmp is map
        && beforeStat is map && afterStat is map
        && afterEmp.diff(beforeEmp).affectedKeys().hasOnly(['publishedCount'])
        && (afterEmp.get('publishedCount', 0) == beforeEmp.get('publishedCount', 0) + 1
          || afterEmp.get('publishedCount', 0) == beforeEmp.get('publishedCount', 0) - 1)
        && afterStat.diff(beforeStat).affectedKeys().hasOnly(['publicationsCount'])
        && (afterStat.get('publicationsCount', 0) == beforeStat.get('publicationsCount', 0) + 1
          || afterStat.get('publicationsCount', 0) == beforeStat.get('publicationsCount', 0) - 1);
    }

    // Rama FASE 2 de la actualización de `users/{uid}`.
    // `affectedKeys()` devuelve las claves de primer nivel, así que
    // `hasOnly(...)` ya impide tocar `identity`, `auth`, `roles`,
    // `registrationStatus`, `accountStatus`, `emailVerified` u `otpVerified`.
    function isAllowedProfileUpdate(uid) {
      return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['profile', 'worker', 'privacy', 'statistics', 'employer', 'updatedAt'])
        && isValidProfileUpdate()
        && isValidWorkerUpdate()
        && isValidPrivacyUpdate()
        && photoBelongsToOwner(uid)
        && keepsWorkerReputation()
        && createsZeroStatistics()
        && (
          !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['employer']))
          || (
            request.resource.data.activeRole == 'CONTRATANTE'
            && isValidEmployerBlock()
            && keepsEmployerReputation()
          )
        );
    }

    // =============================================================
    //  Verificación de correo OTP
    //  (compatible con plan Spark: la app escribe el hash directamente)
    // =============================================================
    function isValidOtpSession(ownerUid, verifiedState) {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'otpHash', 'verified'])
        && data.uid == ownerUid
        && data.email is string
        && data.email.size() > 3
        && data.otpHash is string
        && data.otpHash.size() > 0
        && data.verified == verifiedState;
    }

    match /email_verifications/{uid} {
      allow read: if isOwner(uid);

      // Crear o refrescar la sesión OTP (reenvío). Una sesión ya verificada
      // no se puede reutilizar ni sobrescribir.
      allow create, update: if isOwner(uid) && isValidOtpSession(uid, false);

      // Marcar el OTP como usado: es la única transición permitida sobre `verified`.
      allow update: if isOwner(uid)
        && resource.data.verified == false
        && request.resource.data.verified == true
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['verified', 'otpHash', 'verifiedAt']);

      allow delete: if isOwner(uid);
    }

    // =============================================================
    //  users/{uid} — FASE 1 + FASE 2
    // =============================================================
    match /users/{uid} {
      // Sin listados: el DNI/RUC nunca debe exponerse en consultas masivas.
      allow list: if false;

      // El dueño puede leer su propio documento (login, perfil, resumen).
      allow get: if isOwner(uid);

      // Alta: solo el propio usuario, con identidad validada por padrón oficial.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && isCompleteRegistration();

      // Actualización:
      //  1) Solo campos de auditoría (último ingreso), o
      //  2) completar el registro cuando aún no estaba VERIFIED, o
      //  3) migración única de cuentas creadas antes de la FASE 1, o
      //  4) FASE 2: completar/editar el perfil (Mi Perfil), o
      //  5) FASE 5: pasos ±1 en contadores de publicaciones, o
      //  6) FASE 9: agregado de reputación (lo escribe QUIEN CALIFICA,
      //     no el dueño: por eso va fuera del isOwner).
      allow update: if (isOwner(uid)
        && (onlyAuditFieldsChanged()
          || (!(resource.data.identity is map) && isCompleteRegistration())
          || (resource.data.registrationStatus != 'VERIFIED'
            && isCompleteRegistration()
            && keepsDocumentNumber())
          || isAllowedContractorActivation(uid)
          || isAllowedWorkerActivation()
          || isAllowedEmployerUpdate(uid)
          || isAllowedActiveRoleSwitch()
          || isAllowedPublicationCounterUpdate()
          || isAllowedProfileUpdate(uid)))
        || (request.auth != null && isAllowedRatingUpdate());

      allow delete: if false;
    }

    // =============================================================
    //  usernames/{username} — unicidad del @usuario (FASE 2)
    // =============================================================
    //
    // Un documento por @usuario normalizado. La transacción de
    // ProfileRepository es la que garantiza que dos personas no puedan tomar
    // el mismo nombre a la vez.
    match /usernames/{username} {
      // Consulta puntual de disponibilidad: cualquier usuario autenticado.
      allow get: if request.auth != null;

      // Sin listados: permitiría enumerar todos los @usuario de la plataforma.
      allow list: if false;

      // Solo se puede tomar un @usuario a nombre propio, con formato válido
      // (FASE 16: antes se podía ocupar cualquier cadena) y sin campos extra.
      allow create: if request.auth != null
        && isValidUsername(username)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'updatedAt']);

      // No se puede robar ni reasignar el @usuario de otro.
      allow update: if request.auth != null
        && isValidUsername(username)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'updatedAt']);

      // Al cambiar o borrar el perfil, el @usuario viejo queda libre.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // =============================================================
    //  workplaces/{workplaceId} — FASE 4 Lugar / establecimiento
    // =============================================================
    //
    // Lectura para autenticados (la Fase 5-6 muestra la sede en publicaciones
    // y búsquedas cercanas); escritura solo del dueño con campos validados.
    match /workplaces/{workplaceId} {
      allow get: if request.auth != null;

      // Sin listado masivo: la Fase 6 filtra por dueño o cercanía con
      // consultas acotadas, no barriendo la colección.
      allow list: if request.auth != null;

      allow create: if request.auth != null
        && isValidWorkplaceCreate(workplaceId);

      allow update: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid
        && isValidWorkplaceUpdate();

      allow delete: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // =============================================================
    //  FASE 5 — Publicaciones publications/{publicationId}
    // =============================================================
    //
    // Lectura pública de ACTIVE+PUBLIC para el feed (Fase 6); el dueño puede
    // leer las suyas en cualquier estado. Escritura solo del dueño contratante
    // con campos validados. La reputación (statistics, workersHired) y el
    // publicador verificado los calcula la plataforma: la app no los inventa.

    function isValidPublicationStatus(v) {
      return v is string && v in ['ACTIVE', 'PAUSED', 'FINISHED', 'ARCHIVED'];
    }

    function isValidPaymentBlock(p) {
      return p is map
        && p.get('amount', 0) is number
        && p.get('amount', 0) > 0
        && p.get('amount', 0) <= 100000
        && p.get('currency', '') == 'PEN'
        && p.get('period', '') in ['HOUR', 'DAY', 'WEEK', 'MONTH', 'JOB']
        && p.get('negotiable', false) is bool;
    }

    function isValidPublicationImages(imgs, ownerUid, pubId) {
      return imgs is list
        && imgs.size() <= 3;
    }

    function hasValidPublicationFields(pubId) {
      let d = request.resource.data;
      return d.get('publicationId', '') == pubId
        && d.get('ownerUid', '') == request.auth.uid
        && isValidPublicationStatus(d.get('status', ''))
        && d.get('visibility', '') in ['PUBLIC', 'HIDDEN']
        && d.get('type', '') == 'JOB_OFFER'
        && d.get('title', '') is string
        && d.get('title', '').size() >= 8
        && d.get('title', '').size() <= 100
        && d.get('description', '') is string
        && d.get('description', '').size() >= 20
        && d.get('description', '').size() <= 2000
        && d.get('category', '') is string
        && d.get('category', '').size() >= 2
        && d.get('category', '').size() <= 60
        && isValidPaymentBlock(d.get('payment', {}))
        && d.get('workersNeeded', 0) is number
        && d.get('workersNeeded', 0) >= 1
        && d.get('workersNeeded', 0) <= 50
        && d.get('location', {}).get('district', '') is string
        && d.get('location', {}).get('district', '').size() >= 2
        && isValidPublicationImages(d.get('images', []), request.auth.uid, pubId);
    }

    function keepsPublicationCounters() {
      let before = resource.data.get('statistics', {});
      let after = request.resource.data.get('statistics', {});
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      return !touched.hasAny(['statistics'])
        || (after.get('views', 0) == before.get('views', 0)
          && after.get('likes', 0) == before.get('likes', 0)
          && after.get('comments', 0) == before.get('comments', 0)
          && after.get('shares', 0) == before.get('shares', 0)
          && after.get('saves', 0) == before.get('saves', 0)
          && after.get('applications', 0) == before.get('applications', 0));
    }

    match /publications/{publicationId} {
      // Feed: cualquiera autenticado puede listar ACTIVE+PUBLIC.
      // El detalle de una pausada/finalizada solo lo ve su dueño.
      allow get: if request.auth != null
        && (resource.data.get('status', '') == 'ACTIVE'
          || resource.data.get('ownerUid', '') == request.auth.uid);
      allow list: if request.auth != null;

      allow create: if request.auth != null
        && hasValidPublicationFields(publicationId)
        && request.resource.data.get('workersHired', 0) == 0
        && request.resource.data.get('createdAt', null) != null
        && request.resource.data.get('updatedAt', null) != null;

      // El dueño edita contenido; el estado cambia por su propio campo.
      // statistics solo se mueve en pasos de ±1 (vistas, likes, guardados,
      // comentarios, postulaciones: Fases 6-10) vía isAllowedStatisticsStep;
      // workersHired/publisher/ownerUid/createdAt los mueve el dueño o la
      // plataforma, nunca un tercero.
      allow update: if request.auth != null
        && ((resource.data.get('ownerUid', '') == request.auth.uid
          && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
          && request.resource.data.get('publicationId', '') == resource.data.get('publicationId', '')
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && keepsPublicationCounters())
          || isAllowedStatisticsStep());

      allow delete: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // =============================================================
    //  FASE 6 — Interacciones del feed
    // =============================================================
    // Documento id = {publicationId}_{uid}: solo su dueño lo escribe.

    function isOwnInteraction(docId) {
      return request.auth != null
        && docId.matches('^.+_' + request.auth.uid + '$');
    }

    match /publication_likes/{docId} {
      allow get, list: if request.auth != null;
      allow create: if isOwnInteraction(docId)
        && request.resource.data.get('userUid', '') == request.auth.uid
        && request.resource.data.get('publicationId', '') is string;
      allow delete: if isOwnInteraction(docId)
        && resource.data.get('userUid', '') == request.auth.uid;
      allow update: if false;
    }

    match /publication_saves/{docId} {
      allow get, list: if request.auth != null;
      allow create: if isOwnInteraction(docId)
        && request.resource.data.get('userUid', '') == request.auth.uid
        && request.resource.data.get('publicationId', '') is string;
      allow delete: if isOwnInteraction(docId)
        && resource.data.get('userUid', '') == request.auth.uid;
      allow update: if false;
    }

    match /hidden_publications/{docId} {
      allow get, list: if request.auth != null
        && resource.data.get('userUid', '') == request.auth.uid;
      allow create: if isOwnInteraction(docId)
        && request.resource.data.get('userUid', '') == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.get('userUid', '') == request.auth.uid;
    }

    match /publication_reports/{reportId} {
      allow get, list: if request.auth != null
        && resource.data.get('reporterUid', '') == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.get('reporterUid', '') == request.auth.uid
        && request.resource.data.get('publicationId', '') is string
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('status', '') == 'PENDING';
      // El estado de moderación no lo toca el usuario normal.
      allow update, delete: if false;
    }

    // =============================================================
    //  FASES 6-10 — Pasos ±1 en statistics de publications
    // =============================================================
    //
    // Vistas, likes, guardados, comentarios y postulaciones los registran
    // usuarios DISTINTOS del dueño (un like lo escribe quien lo da). Sin esta
    // rama esos incrementos se denegarían siempre. Solo se admite mover esos
    // contadores de uno en uno y no tocar nada más.

    function statStepOk(before, after, key) {
      return after.get(key, 0) == before.get(key, 0)
        || after.get(key, 0) == before.get(key, 0) + 1
        || after.get(key, 0) == before.get(key, 0) - 1;
    }

    function isAllowedStatisticsStep() {
      let beforeS = resource.data.get('statistics', '');
      let afterS = request.resource.data.get('statistics', '');
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statistics', 'updatedAt'])
        && beforeS is map && afterS is map
        && afterS.diff(beforeS).affectedKeys()
          .hasOnly(['views', 'likes', 'comments', 'shares', 'saves', 'applications'])
        && statStepOk(beforeS, afterS, 'views')
        && statStepOk(beforeS, afterS, 'likes')
        && statStepOk(beforeS, afterS, 'comments')
        && statStepOk(beforeS, afterS, 'shares')
        && statStepOk(beforeS, afterS, 'saves')
        && statStepOk(beforeS, afterS, 'applications');
    }

    // =============================================================
    //  FASE 7 — Postulaciones applications/{applicationId}
    // =============================================================

    function isValidApplicationCreate() {
      let d = request.resource.data;
      return d.get('applicationId', '') is string
        && d.get('applicationId', '').size() > 0
        && d.get('publicationId', '') is string
        && d.get('publicationId', '').size() > 0
        && d.get('workerUid', '') == request.auth.uid
        && d.get('employerUid', '') is string
        && d.get('employerUid', '').size() > 0
        && d.get('employerUid', '') != request.auth.uid
        && d.get('status', '') == 'PENDING'
        && d.get('message', '') is string
        && d.get('message', '').size() <= 500
        && d.get('createdAt', null) != null
        && d.get('updatedAt', null) != null;
    }

    // PENDING → WITHDRAWN (trabajador) o → ACCEPTED/REJECTED (contratante).
    // Solo cambia status (+updatedAt); el resto es inmutable.
    function isValidApplicationTransition() {
      let from = resource.data.get('status', '');
      let to = request.resource.data.get('status', '');
      let byWorker = resource.data.get('workerUid', '') == request.auth.uid;
      let byEmployer = resource.data.get('employerUid', '') == request.auth.uid;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && ((from == 'PENDING' && to == 'WITHDRAWN' && byWorker)
          || (from == 'PENDING' && (to == 'ACCEPTED' || to == 'REJECTED') && byEmployer));
    }

    match /applications/{applicationId} {
      allow get: if request.auth != null
        && (resource.data.get('workerUid', '') == request.auth.uid
          || resource.data.get('employerUid', '') == request.auth.uid);
      // Sin listado masivo: la app consulta por workerUid/employerUid.
      allow list: if request.auth != null;
      allow create: if request.auth != null && isValidApplicationCreate();
      allow update: if request.auth != null && isValidApplicationTransition();
      allow delete: if false;
    }

    // =============================================================
    //  FASE 8 — Trabajos jobs/{jobId}
    // =============================================================

    function isValidJobCreate() {
      let d = request.resource.data;
      return d.get('jobId', '') is string
        && d.get('jobId', '').size() > 0
        && d.get('employerUid', '') == request.auth.uid
        && d.get('workerUid', '') is string
        && d.get('workerUid', '') != request.auth.uid
        && d.get('applicationId', '') is string
        && d.get('publicationId', '') is string
        && d.get('status', '') == 'ACCEPTED'
        && d.get('agreedPayment', {}).get('amount', 0) is number
        && d.get('agreedPayment', {}).get('amount', 0) > 0
        && d.get('createdAt', null) != null
        && d.get('updatedAt', null) != null;
    }

    function isValidJobTransition() {
      let from = resource.data.get('status', '');
      let to = request.resource.data.get('status', '');
      let party = resource.data.get('workerUid', '') == request.auth.uid
        || resource.data.get('employerUid', '') == request.auth.uid;
      let okMove = (from == 'ACCEPTED' && (to == 'IN_PROGRESS' || to == 'CANCELLED'))
        || (from == 'IN_PROGRESS' && (to == 'COMPLETED' || to == 'CANCELLED'));
      return party && okMove
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'startedAt', 'completedAt', 'updatedAt'])
        && request.resource.data.get('workerUid', '') == resource.data.get('workerUid', '')
        && request.resource.data.get('employerUid', '') == resource.data.get('employerUid', '')
        && request.resource.data.get('applicationId', '') == resource.data.get('applicationId', '')
        && request.resource.data.get('publicationId', '') == resource.data.get('publicationId', '');
    }

    match /jobs/{jobId} {
      allow get: if request.auth != null
        && (resource.data.get('workerUid', '') == request.auth.uid
          || resource.data.get('employerUid', '') == request.auth.uid);
      // La app consulta por applicationId/publicationId+workerUid.
      allow list: if request.auth != null;
      allow create: if request.auth != null && isValidJobCreate();
      allow update: if request.auth != null && isValidJobTransition();
      allow delete: if false;
    }

    // =============================================================
    //  FASE 9 — Calificaciones ratings/{ratingId}
    // =============================================================

    function isAllowedRatingUpdate() {
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      let beforeW = resource.data.get('worker', '');
      let afterW = request.resource.data.get('worker', '');
      let beforeE = resource.data.get('employer', '');
      let afterE = request.resource.data.get('employer', '');
      let beforeS = resource.data.get('statistics', '');
      let afterS = request.resource.data.get('statistics', '');
      let workerStep = touched.hasOnly(['worker', 'statistics', 'updatedAt'])
        && beforeW is map && afterW is map
        && afterW.diff(beforeW).affectedKeys().hasOnly(['ratingAverage', 'ratingCount'])
        && afterW.get('ratingCount', 0) == beforeW.get('ratingCount', 0) + 1
        && afterW.get('ratingAverage', 0.0) is number
        && afterW.get('ratingAverage', 0.0) >= 0.0
        && afterW.get('ratingAverage', 0.0) <= 5.0;
      let employerStep = touched.hasOnly(['employer', 'statistics', 'updatedAt'])
        && beforeE is map && afterE is map
        && afterE.diff(beforeE).affectedKeys().hasOnly(['ratingAverage', 'ratingCount'])
        && afterE.get('ratingCount', 0) == beforeE.get('ratingCount', 0) + 1
        && afterE.get('ratingAverage', 0.0) is number
        && afterE.get('ratingAverage', 0.0) >= 0.0
        && afterE.get('ratingAverage', 0.0) <= 5.0;
      return request.auth != null
        && beforeS is map && afterS is map
        && afterS.diff(beforeS).affectedKeys().hasOnly(['receivedRatingsCount'])
        && afterS.get('receivedRatingsCount', 0) == beforeS.get('receivedRatingsCount', 0) + 1
        && (workerStep || employerStep);
    }

    match /ratings/{ratingId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('toUid', '') is string
        && request.resource.data.get('toUid', '').size() > 0
        && request.resource.data.get('toUid', '') != request.auth.uid
        && request.resource.data.get('jobId', '') is string
        && request.resource.data.get('jobId', '').size() > 0
        && request.resource.data.get('rating', 0) is number
        && request.resource.data.get('rating', 0) >= 1
        && request.resource.data.get('rating', 0) <= 5
        && request.resource.data.get('comment', '') is string
        && request.resource.data.get('comment', '').size() <= 500
        && request.resource.data.get('createdAt', null) != null;
      allow update, delete: if false;
    }

    // =============================================================
    //  FASE 10 — Comentarios comments/{commentId}
    // =============================================================

    match /comments/{commentId} {
      allow get: if request.auth != null
        && (resource.data.get('status', '') == 'VISIBLE'
          || resource.data.get('authorUid', '') == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.get('publicationId', '') is string
        && request.resource.data.get('publicationId', '').size() > 0
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() >= 1
        && request.resource.data.get('text', '').size() <= 500
        && request.resource.data.get('status', '') == 'VISIBLE'
        && request.resource.data.get('createdAt', null) != null;
      allow update: if request.auth != null
        && resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']);
      allow delete: if request.auth != null
        && resource.data.get('authorUid', '') == request.auth.uid;
    }

    // =============================================================
    //  FASE 6/7/17 — Perfiles públicos public_profiles/{uid}
    // =============================================================
    //
    // Solo datos visibles para todos (nombre, @usuario, foto, bio, distrito,
    // verificación y bloques worker/employer sin reputación). La app lo
    // mantiene con syncPublicProfile al guardar perfil, activar roles y
    // enlazar lugar. Los agregados (publicaciones, trabajos, promedios) se
    // calculan en vivo, nunca se duplican aquí.

    function isValidPublicProfile(uid) {
      let d = request.resource.data;
      let w = d.get('worker', '');
      let e = d.get('employer', '');
      return d.get('uid', '') == uid
        && d.get('fullName', '') is string
        && d.get('fullName', '').size() <= 120
        && isValidUsername(d.get('username', ''))
        && d.get('photoUrl', '') is string
        && d.get('photoUrl', '').size() <= 500
        && d.get('bio', '') is string
        && d.get('bio', '').size() <= 500
        && d.get('district', '') is string
        && d.get('district', '').size() <= 80
        && d.get('province', '') is string
        && d.get('province', '').size() <= 80
        && d.get('identityVerified', false) is bool
        && w is map
        && (w.get('specialties', []) is list && w.get('specialties', []).size() <= 3)
        && (w.get('skills', []) is list && w.get('skills', []).size() <= 10)
        && e is map
        && e.get('businessName', '') is string
        && e.get('businessName', '').size() <= 120
        && (e.get('workplaceId', null) == null
          || (e.get('workplaceId', '') is string && e.get('workplaceId', '').size() <= 80));
    }

    match /public_profiles/{uid} {
      allow get, list: if request.auth != null;
      allow create, update: if isOwner(uid) && isValidPublicProfile(uid);
      allow delete: if false;
    }

    // =============================================================
    //  FASE 12 — Bloqueos user_blocks/{blockerUid_blockedUid}
    // =============================================================
    //
    // Id determinístico para que las reglas del chat puedan comprobar el
    // bloqueo en ambas direcciones sin consultas adicionales.

    match /user_blocks/{docId} {
      allow get: if request.auth != null
        && resource.data.get('blockerUid', '') == request.auth.uid;
      // La app consulta mis bloqueos (blockerUid == yo).
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.get('blockerUid', '') == request.auth.uid
        && request.resource.data.get('blockedUid', '') is string
        && request.resource.data.get('blockedUid', '').size() > 0
        && request.resource.data.get('blockedUid', '') != request.auth.uid
        && docId == request.resource.data.get('blockerUid', '') + '_' + request.resource.data.get('blockedUid', '')
        && request.resource.data.get('createdAt', null) != null;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.get('blockerUid', '') == request.auth.uid;
    }

    // =============================================================
    //  FASE 12 — Denuncias de usuarios user_reports/{reportId}
    // =============================================================

    match /user_reports/{reportId} {
      allow get, list: if request.auth != null
        && resource.data.get('reporterUid', '') == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.get('reporterUid', '') == request.auth.uid
        && request.resource.data.get('reportedUid', '') is string
        && request.resource.data.get('reportedUid', '').size() > 0
        && request.resource.data.get('reportedUid', '') != request.auth.uid
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() > 0
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 500
        && request.resource.data.get('status', '') == 'PENDING'
        && request.resource.data.get('createdAt', null) != null;
      allow update, delete: if false;
    }

    // =============================================================
    //  FASE 13 — Chat conversations/{conversationId} + messages
    // =============================================================

    function isParticipant(convData) {
      return convData.get('participants', []).hasAny([request.auth.uid]);
    }

    function otherParticipant() {
      let p = request.resource.data.get('participants', []);
      return p[0] == request.auth.uid ? p[1] : p[0];
    }

    function notBlocked() {
      return !exists(/databases/$(database)/documents/user_blocks/$(request.auth.uid + '_' + otherParticipant()))
        && !exists(/databases/$(database)/documents/user_blocks/$(otherParticipant() + '_' + request.auth.uid));
    }

    function isValidConversationCreate() {
      let d = request.resource.data;
      let p = d.get('participants', []);
      return d.get('conversationId', '') is string
        && d.get('conversationId', '').size() > 0
        && p is list && p.size() == 2
        && p.hasOnly([request.auth.uid, otherParticipant()])
        && otherParticipant() != request.auth.uid
        && d.get('publicationId', '') is string
        && d.get('lastMessage', '') is string
        && d.get('lastMessage', '').size() <= 160
        && d.get('lastMessageAt', null) != null
        && d.get('createdAt', null) != null
        && notBlocked();
    }

    match /conversations/{conversationId} {
      // El exists() cubre el get() de un chat aún no creado (recurso nulo:
      // resource.data reventaría). La app primero consulta y solo crea si falta.
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || isParticipant(resource.data));
      // La app consulta whereArrayContains(participants, yo).
      allow list: if request.auth != null;
      allow create: if request.auth != null && isValidConversationCreate();
      // Solo el avance del último mensaje (el texto vive en messages/).
      allow update: if request.auth != null && isParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt'])
        && request.resource.data.get('lastMessage', '') is string
        && request.resource.data.get('lastMessage', '').size() <= 160;
      allow delete: if false;

      // Mensajes: solo participantes (se verifica contra el documento padre).
      match /messages/{messageId} {
        allow get, list: if request.auth != null
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if request.auth != null
          && request.resource.data.get('senderUid', '') == request.auth.uid
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.get('type', '') == 'TEXT'
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() >= 1
          && request.resource.data.get('text', '').size() <= 1000
          && request.resource.data.get('read', true) == false
          && request.resource.data.get('createdAt', null) != null;
        // Solo marcar como leído.
        allow update: if request.auth != null
          && resource.data.get('senderUid', '') != request.auth.uid
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.get('read', false) == true;
        allow delete: if false;
      }
    }

    // =============================================================
    //  FASE 15 — Categorías categories/{categoryId}
    // =============================================================
    //
    // Lectura abierta; la escritura es administrativa (seed con credenciales
    // de proyecto), nunca desde la app.

    match /categories/{categoryId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    // FASE 7/14 — Notificaciones (la bandeja completa con push es FASE 14).
    match /notifications/{notificationId} {
      allow get: if request.auth != null
        && resource.data.get('recipientUid', '') == request.auth.uid;
      // La app consulta por recipientUid.
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.get('senderUid', '') == request.auth.uid
        && request.resource.data.get('recipientUid', '') is string
        && request.resource.data.get('recipientUid', '').size() > 0
        && request.resource.data.get('type', '') is string
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('read', true) == false
        && request.resource.data.get('createdAt', null) != null;
      // El destinatario solo puede marcar como leída.
      allow update: if request.auth != null
        && resource.data.get('recipientUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.get('read', false) == true;
      allow delete: if false;
    }
  }
}
