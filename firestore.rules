rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Verificación de correo OTP (Compatible con plan Spark sin Cloud Functions)
    // El usuario autenticado solo puede acceder a su propio registro de verificación
    match /email_verifications/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfil del usuario autenticado
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
